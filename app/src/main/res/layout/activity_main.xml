<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000" tools:context=".MainActivity">
    <!--  Server sidebar  -->
    <LinearLayout android:id="@+id/sidebar" android:layout_width="68dp" android:layout_height="0dp" android:orientation="vertical" android:gravity="center_horizontal" android:paddingTop="16dp" android:background="#111214" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/profileBar">
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:layout_marginBottom="18dp" android:src="@drawable/dog_avatar" android:contentDescription="Dog server 1"/>
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:layout_marginBottom="18dp" android:src="@drawable/dog_avatar" android:contentDescription="Dog server 2"/>
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:layout_marginBottom="18dp" android:src="@drawable/dog_avatar" android:contentDescription="Dog server 3"/>
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:layout_marginBottom="18dp" android:src="@drawable/dog_avatar" android:contentDescription="Dog server 4"/>
    </LinearLayout>
    <TextView android:id="@+id/serverTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="12dp" android:layout_marginTop="18dp" android:text="The Dog Park ›" android:textColor="#F2F3F5" android:textSize="23sp" android:textStyle="bold" app:layout_constraintStart_toEndOf="@id/sidebar" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent"/>
    <TextView android:id="@+id/searchBar" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="16dp" android:layout_marginEnd="12dp" android:layout_marginTop="16dp" android:background="#17181B" android:gravity="center" android:text="Search" android:textSize="18sp" android:textColor="#DBDEE1" app:layout_constraintStart_toEndOf="@id/sidebar" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/serverTitle"/>
    <!--  Only the channel list scrolls, the profile stays at the bottom.  -->
    <ScrollView android:id="@+id/channelScroll" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginTop="14dp" android:fillViewport="true" app:layout_constraintStart_toEndOf="@id/sidebar" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/searchBar" app:layout_constraintBottom_toTopOf="@id/profileBar">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingBottom="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:text="Server Boosts" android:textSize="18sp" android:textColor="#949BA4"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:text="Text Channels ⌄" android:textSize="16sp" android:textColor="#B5BAC1" android:textStyle="bold" android:layout_marginTop="12dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:text="# general-barking" android:textSize="18sp" android:textColor="#F2F3F5" android:background="#232428"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:text="# treat-talk" android:textSize="18sp" android:textColor="#949BA4"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:text="# fetch-club" android:textSize="18sp" android:textColor="#949BA4"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:text="# puppy-pictures" android:textSize="18sp" android:textColor="#949BA4"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:text="# favorite-toys" android:textSize="18sp" android:textColor="#949BA4"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:text="Voice Channels ⌄" android:textSize="16sp" android:textColor="#B5BAC1" android:textStyle="bold" android:layout_marginTop="12dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:text="♫ Bark Lounge" android:textSize="18sp" android:textColor="#949BA4"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:text="♫ Walkies" android:textSize="18sp" android:textColor="#949BA4"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:text="♫ Nap Time" android:textSize="18sp" android:textColor="#949BA4"/>
        </LinearLayout>
    </ScrollView>
    <!--  Bottom user profile  -->
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/profileBar" android:layout_width="0dp" android:layout_height="76dp" android:background="#111214" android:padding="12dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent">
        <ImageView android:id="@+id/profileAvatar" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/dog_avatar" android:contentDescription="Good Boy dog avatar" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
        <TextView android:id="@+id/profileName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Good Boy ⌄" android:textColor="#F2F3F5" android:textSize="18sp" android:textStyle="bold" app:layout_constraintStart_toEndOf="@id/profileAvatar" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="@id/profileAvatar"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginTop="4dp" android:text="Invisible" android:textColor="#949BA4" android:textSize="14sp" app:layout_constraintStart_toEndOf="@id/profileAvatar" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/profileName"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>